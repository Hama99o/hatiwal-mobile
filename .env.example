# Copy to .env for LOCAL development.
#
# EXPO_PUBLIC_* values are inlined into the build at build time. PRODUCTION
# values are NOT set here — they come from the build profiles in eas.json
# (which use public https:// / wss:// URLs). A release build that bakes in a
# localhost / LAN / http:// URL is rejected at startup by the guard in
# src/api/http.ts.

# Local dev: your machine's LAN IP, so a physical device can reach Metro + Rails.
HOST_IP=192.168.1.10
EXPO_PUBLIC_API_URL=http://192.168.1.10:3007/api/v1
EXPO_PUBLIC_CABLE_URL=ws://192.168.1.10:3098/hatiwal-cable
EXPO_PUBLIC_DEV_PORT=3008

EXPO_PUBLIC_APP_NAME=Hatiwal
EXPO_PUBLIC_DEFAULT_LANG=ps
EXPO_PUBLIC_DEFAULT_THEME=system

# FlowApp (MultiMagics Kanban) — keep the real key in ~/.bashrc, never commit it.
FLOWAPP_API_KEY=fa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

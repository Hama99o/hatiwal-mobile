{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.hatiwal.app/api/v1",
        "EXPO_PUBLIC_CABLE_URL": "wss://staging.hatiwal.app/hatiwal-cable"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.hatiwal.app/api/v1",
        "EXPO_PUBLIC_CABLE_URL": "wss://api.hatiwal.app/hatiwal-cable"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

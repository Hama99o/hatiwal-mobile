{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hatiwal-api.multimagics.com/api/v1",
        "EXPO_PUBLIC_CABLE_URL": "wss://hatiwal-api.multimagics.com/hatiwal-cable",
        "EXPO_PUBLIC_WEB_URL": "https://hatiwal.multimagics.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hatiwal-api.multimagics.com/api/v1",
        "EXPO_PUBLIC_CABLE_URL": "wss://hatiwal-api.multimagics.com/hatiwal-cable",
        "EXPO_PUBLIC_WEB_URL": "https://hatiwal.multimagics.com"
      }
    }
  },
  "submit": {
    "preview": {},
    "production": {
      "ios": {
        "ascAppId": "6789510903"
      }
    }
  }
